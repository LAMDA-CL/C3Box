    "aug_des_path": "./utils/area/descriptions/cifar100/generated_descriptions_aug",
    "vib_lambda": 1.0,
    "precomputed_basis_path": "./utils/area/precomputed_basis/cifar100/",
    "g_lambda": 0.1,
